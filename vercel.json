{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/agenda", "destination": "/resultats", "permanent": true },
    { "source": "/agenda.html", "destination": "/resultats", "permanent": true },
    { "source": "/actualites", "destination": "/resultats", "permanent": true },
    { "source": "/actualites.html", "destination": "/resultats", "permanent": true },
    { "source": "/partenaires", "destination": "/contact", "permanent": true },
    { "source": "/partenaires.html", "destination": "/contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}